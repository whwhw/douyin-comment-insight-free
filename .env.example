# 在线采集配置
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.dev
# 留空使用本技能目录/workspace；升级时保留
DOUYIN_INSIGHT_WORKSPACE=
# 可执行文件不在 PATH 时填写绝对路径
FFMPEG_PATH=
FFPROBE_PATH=
WHISPER_CLI_PATH=
# 本地转写需配置多语言模型，例如 ggml-small.bin
WHISPER_MODEL_PATH=
ASR_LANGUAGE=zh
ASR_PROVIDER=cloud
# 高速文案提取配置
VOLCENGINE_SPEECH_API_KEY=
# 旧版凭据（与 API Key 二选一）
VOLCENGINE_SPEECH_APP_ID=
VOLCENGINE_SPEECH_ACCESS_TOKEN=
